<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>bOps.Api</RootNamespace>
    <AssemblyName>bOps.Api</AssemblyName>
    <!-- ADR-0057 section U.5 (D-049): Knowledge discovery needs real Unicode normalization (NFC/NFKC), which invariant globalization
         does not provide. This is a Knowledge host, so it opts out of the repository default (Directory.Build.props). The culture itself
         stays invariant (HostCulture.PinInvariant). On Linux this needs libicu; DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 turns it off and
         Knowledge then reports itself unavailable instead of running degraded. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1308 is silent under invariant globalization and fires under full globalization; see docs/architecture/suppressions.md. -->
    <NoWarn>$(NoWarn);CA1308</NoWarn>
    <Description>The bOps HTTP API — a second, non-privileged client of the same local runtime the CLI drives (agentic/00-project-spec.md, principle 6; ADR-0018).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every type here is internal (CA1515 — this is an application, not a library); the test
         project needs the top-level Program marker and the endpoint/DTO types it exercises directly. -->
    <InternalsVisibleTo Include="bOps.Api.Tests" />
    <!-- E2E-8 (ADR-0043 §18.1): the test-only host that runs this composition root on Kestrel for the Playwright gate. -->
    <InternalsVisibleTo Include="bOps.Api.E2EHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\bOps.Abstractions\bOps.Abstractions.csproj" />
    <ProjectReference Include="..\bOps.AgentFramework\bOps.AgentFramework.csproj" />
    <ProjectReference Include="..\bOps.Audit\bOps.Audit.csproj" />
    <ProjectReference Include="..\bOps.Memory\bOps.Memory.csproj" />
    <ProjectReference Include="..\bOps.Hosting\bOps.Hosting.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Docker\bOps.Packages.Docker.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Filesystem\bOps.Packages.Filesystem.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Web\bOps.Packages.Web.csproj" />
    <ProjectReference Include="..\bOps.Policy\bOps.Policy.csproj" />
    <ProjectReference Include="..\bOps.PluginHost\bOps.PluginHost.csproj" />
    <ProjectReference Include="..\bOps.Runtime\bOps.Runtime.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.OpenRouter\bOps.Packages.Providers.OpenRouter.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.Ollama\bOps.Packages.Providers.Ollama.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.LlamaCpp\bOps.Packages.Providers.LlamaCpp.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.OpenAi\bOps.Packages.Providers.OpenAi.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.DeepSeek\bOps.Packages.Providers.DeepSeek.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.Anthropic\bOps.Packages.Providers.Anthropic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Http ships as part of the ASP.NET Core shared framework here, unlike
         in bOps.Cli's Worker-SDK project — no explicit PackageReference needed or allowed. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

  <Target Name="CopyFirewallWindowsHelper" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\..\packages\bOps.Packages.Firewall.Windows.Helper\bOps.Packages.Firewall.Windows.Helper.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained" />
    <ItemGroup>
      <_FirewallHelper Include="$(MSBuildProjectDirectory)\..\..\packages\bOps.Packages.Firewall.Windows.Helper\bin\$(Configuration)\net10.0-windows\bOps.Packages.Firewall.Windows.Helper.*" />
      <ResolvedFileToPublish Include="@(_FirewallHelper)" RelativePath="%(_FirewallHelper.Filename)%(_FirewallHelper.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Copy SourceFiles="@(_FirewallHelper)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyWindowsUpdatesHelper" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\..\packages\bOps.Packages.System.Windows.Updates.Helper\bOps.Packages.System.Windows.Updates.Helper.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained" />
    <ItemGroup>
      <_UpdatesHelper Include="$(MSBuildProjectDirectory)\..\..\packages\bOps.Packages.System.Windows.Updates.Helper\bin\$(Configuration)\net10.0-windows\bOps.Packages.System.Windows.Updates.Helper.*" />
      <ResolvedFileToPublish Include="@(_UpdatesHelper)" RelativePath="%(_UpdatesHelper.Filename)%(_UpdatesHelper.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Copy SourceFiles="@(_UpdatesHelper)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- F-26: the Web SDK publishes every **/*.json as Content. Runtime state and local development files can sit in this folder on a
       developer machine (all are git-ignored); none may ever reach a published artifact. Test-PublishedArtifact.ps1 re-checks this. -->
  <ItemGroup>
    <Content Remove="settings.json;plugins.json;publisher-trust.json;secrets.json;appsettings.Development.json;appsettings.Local.json" />
  </ItemGroup>

  <!-- F-26 (BOPS-0120): production hosting of the Angular SPA.
       A normal `dotnet build` never touches Node or Angular. `dotnet publish` of this project ships the compiled SPA beside the binaries
       in wwwroot-ui/ and FAILS when it is missing or incomplete, so a frontend is never dropped silently. Build the SPA first with
       `npm ci && npm run build` in web/bops-ui (scripts/Publish-Bops.ps1 does both), or publish a backend-only artifact on purpose with
       -p:BopsWebUi=false. The published appsettings.Production.json (Content, publish only) binds Kestrel to http://localhost:5080 and
       trusts exactly that browser origin; the host serves the SPA when wwwroot-ui/ exists (WebUiSettings). -->
  <PropertyGroup>
    <BopsWebUi Condition="'$(BopsWebUi)' == ''">true</BopsWebUi>
    <BopsWebUiDir Condition="'$(BopsWebUiDir)' == ''">$(MSBuildProjectDirectory)/../../../web/bops-ui/dist/bops-ui/browser</BopsWebUiDir>
  </PropertyGroup>

  <Target Name="BopsValidateWebUi" BeforeTargets="PrepareForPublish" Condition="'$(BopsWebUi)' != 'false'">
    <ItemGroup>
      <_BopsUiMain Include="$(BopsWebUiDir)\main-*.js" />
      <_BopsUiPolyfills Include="$(BopsWebUiDir)\polyfills-*.js" />
      <_BopsUiStyles Include="$(BopsWebUiDir)\styles-*.css" />
    </ItemGroup>
    <Error Condition="!Exists('$(BopsWebUiDir)\index.html')"
           Text="bOps.Api publish needs the compiled Angular SPA, but '$(BopsWebUiDir)\index.html' does not exist. Run 'npm ci &amp;&amp; npm run build' in web/bops-ui (or scripts/Publish-Bops.ps1), or pass -p:BopsWebUi=false for a deliberate backend-only artifact." />
    <Error Condition="'@(_BopsUiMain)' == '' Or '@(_BopsUiPolyfills)' == '' Or '@(_BopsUiStyles)' == ''"
           Text="The Angular build in '$(BopsWebUiDir)' is incomplete (main-*.js, polyfills-*.js or styles-*.css is missing). Rebuild it with 'npm run build' in web/bops-ui." />
  </Target>

  <Target Name="BopsIncludeWebUi" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="BopsValidateWebUi" Condition="'$(BopsWebUi)' != 'false'">
    <ItemGroup>
      <_BopsUiFile Include="$(BopsWebUiDir)\**\*" />
      <ResolvedFileToPublish Include="@(_BopsUiFile)" RelativePath="wwwroot-ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
