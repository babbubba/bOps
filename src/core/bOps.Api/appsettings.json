{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "ApiKeys": [
      {
        "Id": "local-operator",
        "DisplayName": "Local operator",
        "Secret": {
          "Provider": "environment",
          "Name": "BOPS_API_KEY"
        },
        "Roles": "viewer,operator,approver,administrator"
      }
    ]
  },
  "ModelProvider": {
    "Provider": "OpenRouter",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKeySecret": {
      "Provider": "environment",
      "Name": "BOPS_MODELPROVIDER_API_KEY"
    },
    "Model": "openrouter/free",
    "SupportsNativeToolCalling": true
  },
  "Agent": {
    "MaxSteps": 15,
    "DefaultToolTimeout": "00:00:30",
    "MaxObservationCharacters": 4000
  },
  "Api": {
    "Tasks": {
      "MaxConcurrentTasks": 2
    }
  },
  "Audit": {
    "FilePath": "audit.jsonl"
  },
  "Memory": {
    "FilePath": "tasks.db"
  },
  "Policy": {
    "FilePath": "policy.yaml"
  },
  "Plugins": {
    "RootPath": "plugins",
    "StorePath": "plugins.json",
    "TrustStorePath": "publisher-trust.json"
  },
  "Vault": {
    "FilePath": "vault.dat"
  },
  "Settings": {
    "FilePath": "settings.json"
  },
  "Filesystem": {
    "ReadPatterns": ["*","c:\\**"],
    "WritePatterns": [],
    "Inventory": {
      "ManifestStorePath": "filesystem-inventory.db",
      "ManifestRetention": "1.00:00:00",
      "DefaultMaxDepth": 32,
      "MaximumDepth": 128,
      "DefaultMaxEntries": 10000,
      "MaximumEntries": 900000,
      "DefaultTopEntries": 10,
      "MaximumTopEntries": 100,
      "DefaultDuration": "00:00:20",
      "MaximumDuration": "00:02:00",
      "MaximumWarnings": 32,
      "MaximumOutputBytes": 131072
    }
  },
  "Web": {
    "Search": {
      "BaseUrl": "",
      "Timeout": "00:00:10",
      "MaxResults": 10,
      "MaxResultTextBytes": 1024,
      "MaxResponseBytes": 2097152
    },
    "Fetch": {
      "ConnectTimeout": "00:00:05",
      "OverallTimeout": "00:00:15",
      "MaxRedirects": 5,
      "MaxResponseBytes": 1048576,
      "MaxDecompressedBytes": 4194304,
      "AllowSchemeDowngradeOnRedirect": false,
      "AllowedContentTypes": ["text/plain", "text/html", "text/markdown", "application/json", "application/xml", "text/xml", "text/csv"],
      "AllowedAddresses": [],
      "AllowedNetworks": []
    }
  }
}
