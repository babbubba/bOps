{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "ApiKeys": [
      {
        "Id": "local-operator",
        "DisplayName": "Local operator",
        "Secret": {
          "Provider": "environment",
          "Name": "BOPS_API_KEY"
        },
        "Roles": "viewer,operator,approver"
      }
    ]
  },
  "ModelProvider": {
    "Provider": "OpenRouter",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKeySecret": {
      "Provider": "environment",
      "Name": "BOPS_MODELPROVIDER_API_KEY"
    },
    "Model": "openrouter/free",
    "SupportsNativeToolCalling": true
  },
  "Agent": {
    "MaxSteps": 15,
    "DefaultToolTimeout": "00:00:30",
    "MaxObservationCharacters": 4000
  },
  "Api": {
    "Tasks": {
      "MaxConcurrentTasks": 2
    }
  },
  "Audit": {
    "FilePath": "audit.jsonl"
  },
  "Memory": {
    "FilePath": "tasks.db"
  },
  "Policy": {
    "FilePath": "policy.yaml"
  },
  "Filesystem": {
    "ReadPatterns": [],
    "WritePatterns": []
  }
}
