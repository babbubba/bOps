<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>bOps.Runtime</RootNamespace>
    <AssemblyName>bOps.Runtime</AssemblyName>
    <Description>The agent loop, tool registry, and capability discovery — agentic/01-architecture-rules.md.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\bOps.Abstractions\bOps.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The envelope reduction is the security boundary of V1.2 (ADR-0030, ADR-0031): internal, so nothing
         outside the runtime can call it, and visible to its own tests. -->
    <InternalsVisibleTo Include="bOps.Runtime.Tests" />
    <!-- AF-05: the MAF regression harness drives the real runner with the real MAF projector and needs the runner's
         internal control-protocol constants. -->
    <InternalsVisibleTo Include="bOps.AgentFramework.Tests" />
  </ItemGroup>

</Project>
