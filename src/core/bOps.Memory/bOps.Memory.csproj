<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>bOps.Memory</RootNamespace>
    <AssemblyName>bOps.Memory</AssemblyName>
    <Description>Persistent, resumable task state — agentic/00-project-spec.md, V0.7; ADR-0017.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\bOps.Abstractions\bOps.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <!-- Microsoft.Data.Sqlite 10.0.8 still pins the transitive SQLitePCLRaw.* dependencies to
         2.1.11, which has a known high-severity advisory (GHSA-2m69-gcr7-jv3q). Overriding with
         a direct reference to the patched 3.0.3 is the documented mitigation until Microsoft.Data.Sqlite
         itself bumps its floor (docs/architecture/suppressions.md). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

</Project>
