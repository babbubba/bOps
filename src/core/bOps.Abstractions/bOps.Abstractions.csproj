<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>bOps.Abstractions</RootNamespace>
    <AssemblyName>bOps.Abstractions</AssemblyName>
    <Description>The bOps plugin SDK: the single stable contract referenced by the runtime, first-party packages, and third-party packages alike. Zero dependencies.</Description>
    <PackageId>bOps.Abstractions</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- ADR-0022: V1.0 freezes the public SDK surface; SemVer is binding from this version. -->
