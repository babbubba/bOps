{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "ModelProvider": {
    "Provider": "OpenRouter",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKeySecret": {
      "Provider": "environment",
      "Name": "BOPS_MODEL_API_KEY"
    },
    "Model": "openrouter/free",
    "SupportsNativeToolCalling": true
  },
  "Agent": {
    "MaxSteps": 15,
    "DefaultToolTimeout": "00:00:30",
    "MaxObservationCharacters": 4000
  },
  "Audit": {
    "FilePath": "audit.jsonl"
  },
  "Policy": {
    "FilePath": "policy.yaml"
  },
  "Plugins": {
    "RootPath": "plugins",
    "StorePath": "plugins.json",
    "TrustStorePath": "publisher-trust.json"
  },
  "Filesystem": {
    "ReadPatterns": [],
    "WritePatterns": []
  }
}
