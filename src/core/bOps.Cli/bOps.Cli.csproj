<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>bOps.Cli</RootNamespace>
    <AssemblyName>bops</AssemblyName>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Description>The bOps CLI — `bops "&lt;goal&gt;"`. The primary interface (agentic/00-project-spec.md, principle 6).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\bOps.Abstractions\bOps.Abstractions.csproj" />
    <ProjectReference Include="..\bOps.Audit\bOps.Audit.csproj" />
    <ProjectReference Include="..\bOps.Memory\bOps.Memory.csproj" />
    <ProjectReference Include="..\bOps.PluginHost\bOps.PluginHost.csproj" />
    <ProjectReference Include="..\bOps.Policy\bOps.Policy.csproj" />
    <ProjectReference Include="..\bOps.Runtime\bOps.Runtime.csproj" />
    <!-- First-party packages stay project-referenced directly, exactly as before V0.10 — dynamic
         loading (ADR-0020) is for third-party plugins installed via `bops plugin *`, not a
         replacement for how bOps's own packages are composed. -->
    <ProjectReference Include="..\..\packages\bOps.Packages.System.Windows\bOps.Packages.System.Windows.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.System.Linux\bOps.Packages.System.Linux.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Filesystem\bOps.Packages.Filesystem.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Network\bOps.Packages.Network.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Network.Native.Windows\bOps.Packages.Network.Native.Windows.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Network.Native.Linux\bOps.Packages.Network.Native.Linux.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Service.Windows\bOps.Packages.Service.Windows.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Service.Linux\bOps.Packages.Service.Linux.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Docker\bOps.Packages.Docker.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Web\bOps.Packages.Web.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.OpenRouter\bOps.Packages.Providers.OpenRouter.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.Ollama\bOps.Packages.Providers.Ollama.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.LlamaCpp\bOps.Packages.Providers.LlamaCpp.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.OpenAi\bOps.Packages.Providers.OpenAi.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.DeepSeek\bOps.Packages.Providers.DeepSeek.csproj" />
    <ProjectReference Include="..\..\packages\bOps.Packages.Providers.Anthropic\bOps.Packages.Providers.Anthropic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="bOps.Cli.Tests" />
  </ItemGroup>

</Project>
