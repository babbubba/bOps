<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>bOps.Packages.Providers.Anthropic</RootNamespace>
    <AssemblyName>bOps.Packages.Providers.Anthropic</AssemblyName>
    <Description>The Anthropic model provider package — the one native (non-OpenAI-compatible) adapter (ADR-0005).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\bOps.Abstractions\bOps.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One shared implementation of the wire-name map (ADR-0038), owned by the OpenAI-compatible package. Linked, not referenced: provider packages must not depend on each other (rule B6). -->
    <Compile Include="..\bOps.Packages.Providers.OpenAiCompatible\Wire\ToolWireNames.cs" Link="Wire\ToolWireNames.cs" />
    <!-- One shared implementation of strict duplicate-key-safe JSON parsing (ADR-0038, HARDEN-1 review M-2), owned the same way. -->
    <Compile Include="..\bOps.Packages.Providers.OpenAiCompatible\Wire\StrictJson.cs" Link="Wire\StrictJson.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

</Project>
