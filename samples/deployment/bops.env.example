# bOps environment file (F-26). One KEY=VALUE per line, no quotes, no `export`.
# Linux: copy to /etc/bops/bops.env, `chown root:bops`, `chmod 640`.   (systemd EnvironmentFile)
# Windows: copy to C:\ProgramData\bOps\bops.env and restrict its ACL to the account that runs bOps.   (read by Start-Bops.ps1)
# Never commit a real copy. The values below are placeholders.

# --- Required ---------------------------------------------------------------------------------------------------------
# The key you type on the web UI sign-in screen (and use as a Bearer token). Generate a long random value.
BOPS_API_KEY=change-me-long-random-value
# Protects the encrypted local vault behind the Settings page; at least 20 characters. The API refuses to start without it.
BOPS_VAULT_MASTER_KEY=change-me-at-least-20-characters

# --- Where the browser reaches bOps (must match exactly what is typed in the address bar) -----------------------------
# Mode A (local install): leave these lines out; the published appsettings.Production.json already says http://localhost:5080.
# Mode B (TLS reverse proxy): the public HTTPS origin, exactly scheme://host[:port], no path, no trailing slash.
#BrowserSession__Origins=https://bops.example.com
# Keep Kestrel on loopback behind the proxy.
#Kestrel__Endpoints__Http__Url=http://127.0.0.1:5080
# The proxy's address, so the per-address sign-in rate limit sees browsers. Leave unset when there is no proxy.
#ReverseProxy__KnownProxies=127.0.0.1

# --- Model provider (optional until you run agent tasks) --------------------------------------------------------------
#BOPS_MODELPROVIDER_API_KEY=
# What the Filesystem tools may read; nothing is readable until you list it (the shipped default is a Windows path).
#Filesystem__ReadPatterns__0=/var/log/**
