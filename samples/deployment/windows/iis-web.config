<?xml version="1.0" encoding="utf-8"?>
<!--
  F-26 sample, Mode B on Windows: IIS terminates TLS and reverse-proxies the site root to bOps on loopback.
  Needs the IIS "URL Rewrite" module and "Application Request Routing" with the proxy enabled
  (IIS Manager > server > Application Request Routing Cache > Server Proxy Settings > Enable proxy).
  NOT verified in this repository's CI (no IIS runner): treat it as a starting point and test it before relying on it.

  Put this file in the IIS site's physical path, bind the site to https with your certificate, then on the bOps side set
    BrowserSession__Origins=https://bops.example.com     (exactly what the browser shows)
    Kestrel__Endpoints__Http__Url=http://127.0.0.1:5080
    ReverseProxy__KnownProxies=127.0.0.1                  (optional: sign-in rate limit per browser instead of per proxy)

  Allow the two server variables once per site (URL Rewrite > View Server Variables > Add):
    HTTP_X_FORWARDED_FOR and HTTP_X_FORWARDED_PROTO.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="bOps reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- Replace, never append: a client cannot inject a forwarded address. -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:5080/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Plugin archives up to 64 MiB (Plugins:Archive default) plus overhead. -->
        <requestLimits maxAllowedContentLength="73400320" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
