<Project Sdk="Microsoft.NET.Sdk">

  <!-- BOPS-0126 MAF-DIAG-EVAL-01: a test-side console harness that scores the diagnostic quality of runs an A/B/C/D campaign
       (BOPS-0125) already recorded. It never runs the agent, never ships and no src/ project references it. It uses the evaluation
       framework of Microsoft Agent Framework (EvalItem, LocalEvaluator, FunctionEvaluator) at the same exact pin as
       bOps.AgentFramework; no MAF type reaches bOps.Abstractions, the Runtime surface or a persistence contract (C01-R02). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>bOps.DiagnosticEvaluation</RootNamespace>
    <AssemblyName>bOps.DiagnosticEvaluation</AssemblyName>
    <Description>Offline, deterministic scoring of recorded benchmark runs (BOPS-0126). Never shipped.</Description>
    <IsPackable>false</IsPackable>
    <!-- Full globalization: answers are Italian text compared case-insensitively. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- A measurement harness, not product code, like bOps.QwenLiveBaseline: analyzer noise must not stop an evaluation. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <NoWarn>$(NoWarn);MAAI001;CA1507;CA1812;CA1031;CA1707;CA1062;CA1822;CA1861;CA1859;CA2201;IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="bOps.DiagnosticEvaluation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="[1.24.0]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="keys\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
