<Project Sdk="Microsoft.NET.Sdk">

  <!-- REPLAY-CAPTURE-T02B-01: a test-only console harness (outside bOps.slnx, never ships) that captures, from the REAL local system.events /
       system.stability / system.crashes collectors, the controlled snapshot "T02-B" for the QWEN-LIVE-BASELINE replay. No model, no mutating tool:
       a closed list of read-only queries, argument validation and the read-only policy before every call, and nothing is read from the machine
       unless the `capture` command is given its explicit enabling arguments. See Program.cs and docs/benchmarks/replay-capture-t02b-01.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>bOps.ReplayFixtureCapture</RootNamespace>
    <AssemblyName>bOps.ReplayFixtureCapture</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Like bOps.Cli: full globalization with the culture pinned invariant in Main, so the collectors run under the same culture as when
         the T02 fixtures were first captured through the CLI. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1812;CA1031;CA1707;CA1062;CA1822;CA1861;CA1859;CA2201;CA1416;IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\bOps.Abstractions\bOps.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\core\bOps.Policy\bOps.Policy.csproj" />
    <ProjectReference Include="..\..\src\packages\bOps.Packages.System.Core\bOps.Packages.System.Core.csproj" />
    <ProjectReference Include="..\..\src\packages\bOps.Packages.System.Windows\bOps.Packages.System.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runtime's own argument validator (internal to bOps.Runtime) and the replay matcher's verified-default specs are compiled in from their
         source, so the capture validates arguments with exactly the code the agent runtime uses and reports effective arguments with the same
         defaults the replay uses. Nothing is copied. -->
    <Compile Include="..\..\src\core\bOps.Runtime\ArgumentSchema.cs" Link="Linked\ArgumentSchema.cs" />
    <Compile Include="..\bOps.QwenLiveBaseline\ReplayMatching.cs" Link="Linked\ReplayMatching.cs" />
    <!-- The unchanged replay loader and matcher: the snapshot validator asks them what the snapshot would serve. Never modified here. -->
    <Compile Include="..\bOps.QwenLiveBaseline\Replay.cs" Link="Linked\Replay.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="bOps.ReplayFixtureCapture.Tests" />
  </ItemGroup>

</Project>
