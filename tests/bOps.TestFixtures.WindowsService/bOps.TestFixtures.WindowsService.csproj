<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>bOpsTestService</AssemblyName>
    <Description>
      A minimal, do-nothing Windows Service, built only so bOps.Packages.Service.Windows.Tests has
      a real, throwaway, safe-to-start/stop/restart/delete service to test against — every
      service.* tool test installs its own uniquely-named instance of this and deletes it in
      cleanup. Never installed for real use, never referenced outside that test project.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

</Project>
