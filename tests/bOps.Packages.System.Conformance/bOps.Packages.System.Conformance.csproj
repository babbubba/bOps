<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>bOps.Packages.Sys.Conformance</RootNamespace>
    <Description>
      Shared assertions any system.* implementation must satisfy, regardless of OS
      (agentic/04-testing-rules.md — "The conformance suite for platform packages"). Referenced
      by bOps.Packages.System.Windows.Tests and bOps.Packages.System.Linux.Tests, each of which
      runs it against its own tools.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.assert" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\bOps.Abstractions\bOps.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\packages\bOps.Packages.System.Core\bOps.Packages.System.Core.csproj" />
  </ItemGroup>

</Project>
