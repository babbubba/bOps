<Project Sdk="Microsoft.NET.Sdk">

  <!-- REPLAY-DEFAULT-EQUIVALENCE-01: tests of the benchmark harness's fixture selection (tests/bOps.QwenLiveBaseline/Replay.cs, ReplayMatching.cs).
       Like the harness it is outside bOps.slnx. The harness source is compiled in directly (not its Program.cs), so the tests exercise
       exactly the code the campaign runs. No model, no network, no machine data: deterministic. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>bOps.QwenLiveBaseline</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1812;CA1031;CA1707;CA1062;CA1822;CA1861;CA1859;CA2201;IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\bOps.QwenLiveBaseline\Replay.cs" Link="Harness\Replay.cs" />
    <Compile Include="..\bOps.QwenLiveBaseline\ReplayMatching.cs" Link="Harness\ReplayMatching.cs" />
    <None Include="legacy-served-calls.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\bOps.Abstractions\bOps.Abstractions.csproj" />
  </ItemGroup>

</Project>
